<?php

/**
 * Campos compartilhados pelos formulários de cadastro (new) e edição (edit).
 *
 * Variáveis esperadas: $targetUser (App\Models\User).
 * Os erros vêm de $targetUser->errors('campo'), preenchidos por User::validates().
 */

use App\Models\User;

$isNew = $targetUser->newRecord();

// Classe Bootstrap que deixa o campo vermelho quando há erro
$invalid = fn(string $field): string => $targetUser->errors($field) !== null ? ' is-invalid' : '';

// Mensagem exibida logo abaixo do campo
$feedback = function (string $field) use ($targetUser): string {
    $message = $targetUser->errors($field);
    if ($message === null) {
        return '';
    }

    $message = mb_strtoupper(mb_substr($message, 0, 1)) . mb_substr($message, 1);

    return '<div class="invalid-feedback" id="error_user_' . $field . '">' . htmlspecialchars($message) . '</div>';
};

$value = fn(string $field): string => htmlspecialchars((string) ($targetUser->$field ?? ''));
?>
<div class="row g-3">
    <!-- Nome -->
    <div class="col-md-6">
        <label for="user_name" class="form-label fw-semibold">Nome Completo <span class="text-danger">*</span></label>
        <input type="text" class="form-control<?= $invalid('name') ?>" id="user_name" name="user[name]"
               value="<?= $value('name') ?>" placeholder="Ex: Lucas Rosa" maxlength="255" required autofocus>
        <?= $feedback('name') ?>
    </div>

    <!-- E-mail -->
    <div class="col-md-6">
        <label for="user_email" class="form-label fw-semibold">E-mail <span class="text-danger">*</span></label>
        <input type="email" class="form-control<?= $invalid('email') ?>" id="user_email" name="user[email]"
               value="<?= $value('email') ?>" placeholder="lucas@arena.com" maxlength="191" required>
        <?= $feedback('email') ?>
    </div>

    <!-- Telefone -->
    <div class="col-md-6">
        <label for="user_phone" class="form-label fw-semibold">Telefone / WhatsApp</label>
        <input type="text" class="form-control<?= $invalid('phone') ?>" id="user_phone" name="user[phone]"
               value="<?= $value('phone') ?>" placeholder="(41) 99999-0000" maxlength="20">
        <?= $feedback('phone') ?>
    </div>

    <!-- CPF -->
    <div class="col-md-6">
        <label for="user_cpf" class="form-label fw-semibold">CPF</label>
        <input type="text" class="form-control<?= $invalid('cpf') ?>" id="user_cpf" name="user[cpf]"
               value="<?= $value('cpf') ?>" placeholder="000.000.000-00" maxlength="14">
        <?= $feedback('cpf') ?>
    </div>

    <!-- Papel (Role) -->
    <div class="col-md-6">
        <label for="user_role" class="form-label fw-semibold">Perfil de Acesso (Role) <span class="text-danger">*</span></label>
        <select class="form-select<?= $invalid('role') ?>" id="user_role" name="user[role]">
            <?php foreach (User::ROLE_OPTIONS as $option => $label) : ?>
                <option value="<?= $option ?>" <?= $targetUser->role === $option ? 'selected' : '' ?>><?= $label ?></option>
            <?php endforeach; ?>
        </select>
        <?= $feedback('role') ?>
    </div>

    <!-- Status Catraca -->
    <div class="col-md-6">
        <label for="user_status" class="form-label fw-semibold">Status de Entrada (Catraca) <span class="text-danger">*</span></label>
        <select class="form-select<?= $invalid('status') ?>" id="user_status" name="user[status]">
            <?php foreach (User::STATUS_OPTIONS as $option => $label) : ?>
                <option value="<?= $option ?>" <?= $targetUser->status === $option ? 'selected' : '' ?>><?= $label ?></option>
            <?php endforeach; ?>
        </select>
        <?= $feedback('status') ?>
    </div>

    <?php if (!$isNew) : ?>
        <div class="col-12 mt-4">
            <div class="alert alert-light border small text-muted mb-0">
                <i class="bi bi-info-circle text-primary"></i>
                <strong>Alteração de Senha:</strong> preencha os campos abaixo apenas se desejar redefinir a senha do usuário.
                Deixe em branco para mantê-la.
            </div>
        </div>
    <?php endif; ?>

    <!-- Senha (nunca é reexibida no formulário) -->
    <div class="col-md-6">
        <label for="user_password" class="form-label fw-semibold">
            <?= $isNew ? 'Senha de Acesso <span class="text-danger">*</span>' : 'Nova Senha (Opcional)' ?>
        </label>
        <input type="password" class="form-control<?= $invalid('password') ?>" id="user_password" name="user[password]"
               placeholder="<?= $isNew ? 'Mínimo ' . User::PASSWORD_MIN_LENGTH . ' caracteres' : 'Deixe em branco para não alterar' ?>"
               minlength="<?= User::PASSWORD_MIN_LENGTH ?>" autocomplete="new-password" <?= $isNew ? 'required' : '' ?>>
        <?= $feedback('password') ?>
    </div>

    <!-- Confirmação de Senha -->
    <div class="col-md-6">
        <label for="user_password_confirmation" class="form-label fw-semibold">
            <?= $isNew ? 'Confirmar Senha <span class="text-danger">*</span>' : 'Confirmar Nova Senha' ?>
        </label>
        <input type="password" class="form-control<?= $invalid('password_confirmation') ?>" id="user_password_confirmation"
               name="user[password_confirmation]" placeholder="Repita a senha digitada" autocomplete="new-password"
               <?= $isNew ? 'required' : '' ?>>
        <?= $feedback('password_confirmation') ?>
    </div>
</div>
