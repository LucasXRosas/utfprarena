<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h1 class="h3 fw-bold text-dark mb-0">Editar Atleta #<?= $targetUser->id ?></h1>
                <small class="text-secondary">Atualize os dados cadastrais e status de catraca de <?= htmlspecialchars($targetUser->name) ?></small>
            </div>
            <a href="/admin/users" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Voltar à Lista
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-dark text-white fw-semibold py-3 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-pencil-square"></i> Edição de Cadastro</span>
                <span class="badge bg-light text-dark">ID: #<?= $targetUser->id ?></span>
            </div>
            <div class="card-body p-4 bg-white">
                <form action="/admin/users/<?= $targetUser->id ?>" method="POST" id="edit_user_form">
                    <input type="hidden" name="_method" value="PUT">

                    <div class="row g-3">
                        <!-- Nome -->
                        <div class="col-md-6">
                            <label for="user_name" class="form-label fw-semibold">Nome Completo <span class="text-danger">*</span></label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="user_name" 
                                name="user[name]" 
                                value="<?= htmlspecialchars($targetUser->name) ?>" 
                                required
                            >
                        </div>

                        <!-- E-mail -->
                        <div class="col-md-6">
                            <label for="user_email" class="form-label fw-semibold">E-mail <span class="text-danger">*</span></label>
                            <input 
                                type="email" 
                                class="form-control" 
                                id="user_email" 
                                name="user[email]" 
                                value="<?= htmlspecialchars($targetUser->email) ?>" 
                                required
                            >
                        </div>

                        <!-- Telefone -->
                        <div class="col-md-6">
                            <label for="user_phone" class="form-label fw-semibold">Telefone / WhatsApp</label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="user_phone" 
                                name="user[phone]" 
                                value="<?= htmlspecialchars($targetUser->phone ?? '') ?>" 
                                placeholder="(41) 99999-0000"
                            >
                        </div>

                        <!-- CPF -->
                        <div class="col-md-6">
                            <label for="user_cpf" class="form-label fw-semibold">CPF</label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="user_cpf" 
                                name="user[cpf]" 
                                value="<?= htmlspecialchars($targetUser->cpf ?? '') ?>" 
                                placeholder="000.000.000-00"
                            >
                        </div>

                        <!-- Papel (Role) -->
                        <div class="col-md-6">
                            <label for="user_role" class="form-label fw-semibold">Perfil de Acesso (Role) <span class="text-danger">*</span></label>
                            <select class="form-select" id="user_role" name="user[role]">
                                <option value="student" <?= $targetUser->isStudent() ? 'selected' : '' ?>>Aluno / Atleta (Beach Tennis)</option>
                                <option value="manager" <?= $targetUser->isAdmin() ? 'selected' : '' ?>>Administrador / Gestor</option>
                            </select>
                        </div>

                        <!-- Status Catraca -->
                        <div class="col-md-6">
                            <label for="user_status" class="form-label fw-semibold">Status de Entrada (Catraca) <span class="text-danger">*</span></label>
                            <select class="form-select" id="user_status" name="user[status]">
                                <option value="active" <?= $targetUser->isActive() ? 'selected' : '' ?>>Ativo (Acesso Liberado)</option>
                                <option value="blocked" <?= $targetUser->isBlocked() ? 'selected' : '' ?>>Bloqueado (Inadimplência / Pendência)</option>
                            </select>
                        </div>

                        <div class="col-12 mt-4">
                            <div class="alert alert-light border small text-muted mb-0">
                                <i class="bi bi-info-circle text-primary"></i> 
                                <strong>Alteração de Senha:</strong> Preencha os campos abaixo apenas se desejar redefinir a senha do usuário. Deixe em branco para mantê-la.
                            </div>
                        </div>

                        <!-- Nova Senha -->
                        <div class="col-md-6">
                            <label for="user_password" class="form-label fw-semibold">Nova Senha (Opcional)</label>
                            <input 
                                type="password" 
                                class="form-control" 
                                id="user_password" 
                                name="user[password]" 
                                placeholder="Deixe em branco para não alterar"
                            >
                        </div>

                        <!-- Confirmação da Nova Senha -->
                        <div class="col-md-6">
                            <label for="user_password_confirmation" class="form-label fw-semibold">Confirmar Nova Senha</label>
                            <input 
                                type="password" 
                                class="form-control" 
                                id="user_password_confirmation" 
                                name="user[password_confirmation]" 
                                placeholder="Repita a nova senha se informada"
                            >
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a href="/admin/users" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4" id="btn_update_user">
                            <i class="bi bi-arrow-repeat"></i> Atualizar Atleta
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
