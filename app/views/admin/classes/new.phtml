<?php
$fieldError = function (string $field, string $label) use ($trainingClass): string {
    $error = $trainingClass->errors($field);
    if ($error === null) {
        return '';
    }

    return '<div class="invalid-feedback" id="error_class_' . $field . '">'
        . htmlspecialchars($label . ' ' . $error) . '</div>';
};
$invalid = fn (string $field): string => $trainingClass->errors($field) !== null ? ' is-invalid' : '';
?>
